<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>404 | Page Not Found | IndoWings</title>
    <meta name="robots" content="noindex, nofollow">

    <link rel="icon" href="https://www.indowings.com/images/favicon.png" type="image/png">

    <!-- Same typography used by the IndoWings theme -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --iw-navy: #191B30;
            --iw-orange: #EF7F1A;
            --iw-orange-dark: #DD6D08;
            --iw-orange-light: #FD9100;
            --iw-white: #FFFFFF;
            --iw-dark: #151515;
            --iw-gray: #848896;
            --iw-line: rgba(255,255,255,.14);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            font-family: "Montserrat", sans-serif;
            background: var(--iw-navy);
            color: var(--iw-white);
            -webkit-font-smoothing: antialiased;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .error-page {
            min-height: 100vh;
            min-height: 100svh;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
            background: var(--iw-navy);
        }

        /* subtle ATS-style technical background */
        .error-page::before {
            content: "";
            position: absolute;
            width: 620px;
            height: 620px;
            border: 1px solid rgba(255,255,255,.045);
            border-radius: 50%;
            right: -220px;
            top: 50%;
            transform: translateY(-50%);
            box-shadow:
                0 0 0 90px rgba(255,255,255,.018),
                0 0 0 180px rgba(255,255,255,.012);
            pointer-events: none;
        }

        .accent-shape {
            position: absolute;
            top: 0;
            right: 0;
            width: 150px;
            height: 100%;
            background: linear-gradient(
                180deg,
                var(--iw-orange-light) 0%,
                var(--iw-orange-dark) 100%
            );
            clip-path: polygon(55% 0, 100% 0, 100% 100%, 0 100%);
            opacity: .95;
            pointer-events: none;
        }

        .container {
            width: min(88%, 1180px);
            margin: 0 auto;
            position: relative;
            z-index: 2;
        }

        .topbar {
            min-height: 92px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--iw-line);
        }

        .logo img {
            display: block;
            width: 155px;
            max-height: 52px;
            object-fit: contain;
            object-position: left center;
        }

        .error-label {
            margin-right: 40px;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: rgba(255,255,255,.55);
        }

        .main-content {
            flex: 1;
            display: flex;
            align-items: center;
        }

        .hero {
            width: 100%;
            padding: 70px 0 58px;
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(320px, .95fr);
            gap: 70px;
            align-items: center;
        }

        .error-copy {
            width: min(100%, 540px);
            justify-self: center;
            transform: translateX(45px);
        }

        .title-mark {
            width: 36px;
            height: 3px;
            margin-bottom: 24px;
            background: var(--iw-orange);
        }

        .code {
            font-size: clamp(110px, 13vw, 190px);
            line-height: .78;
            font-weight: 700;
            letter-spacing: -.08em;
            color: var(--iw-white);
        }

        h1 {
            margin-top: 32px;
            font-size: clamp(30px, 4vw, 48px);
            line-height: 1.075;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0;
        }

        .description {
            max-width: 520px;
            margin-top: 20px;
            color: rgba(255,255,255,.62);
            font-size: 14px;
            line-height: 1.75;
            font-weight: 400;
            letter-spacing: .4px;
        }

        .home-link {
            display: inline-flex;
            align-items: center;
            gap: 14px;
            margin-top: 30px;
            padding: 13px 20px;
            background: linear-gradient(
                0deg,
                var(--iw-orange-dark) 0%,
                var(--iw-orange-light) 100%
            );
            color: #fff;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: .04em;
            text-transform: uppercase;
            transition: transform .25s ease, box-shadow .25s ease;
        }

        .home-link::after {
            content: "→";
            font-size: 17px;
            line-height: 1;
            transition: transform .25s ease;
        }

        .home-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0,0,0,.22);
        }

        .home-link:hover::after {
            transform: translateX(4px);
        }

        .drone-nav {
            border-left: 1px solid var(--iw-line);
            padding-left: 50px;
        }

        .drone-nav-label {
            color: var(--iw-orange);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .14em;
            text-transform: uppercase;
            margin-bottom: 18px;
        }

        .drone-list {
            display: flex;
            flex-direction: column;
        }

        .drone-link {
            min-height: 58px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            border-bottom: 1px solid var(--iw-line);
            color: rgba(255,255,255,.82);
            font-size: 15px;
            font-weight: 500;
            transition:
                color .25s ease,
                padding-left .25s ease,
                border-color .25s ease;
        }

        .drone-link:first-child {
            border-top: 1px solid var(--iw-line);
        }

        .drone-link::after {
            content: "→";
            color: var(--iw-gray);
            font-size: 16px;
            transition: transform .25s ease, color .25s ease;
        }

        .drone-link:hover {
            color: var(--iw-orange);
            padding-left: 8px;
            border-color: rgba(239,127,26,.45);
        }

        .drone-link:hover::after {
            color: var(--iw-orange);
            transform: translateX(4px);
        }

        .footline {
            min-height: 70px;
            display: flex;
            align-items: center;
            border-top: 1px solid var(--iw-line);
            color: var(--iw-gray);
            font-size: 10px;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        @media (max-width: 920px) {
            .error-copy {
                justify-self: start;
                transform: none;
            }

            .accent-shape {
                width: 85px;
                opacity: .65;
            }

            .hero {
                grid-template-columns: 1fr;
                gap: 50px;
                padding: 55px 0 45px;
            }

            .drone-nav {
                border-left: 0;
                border-top: 1px solid var(--iw-line);
                padding: 32px 0 0;
            }

            .error-label {
                margin-right: 20px;
            }
        }

        @media (max-width: 600px) {
            .container {
                width: 86%;
            }

            .topbar {
                min-height: 78px;
            }

            .logo img {
                width: 128px;
            }

            .error-label {
                font-size: 8px;
                margin-right: 16px;
                letter-spacing: .08em;
            }

            .accent-shape {
                width: 54px;
            }

            .hero {
                padding: 46px 0 38px;
            }

            .code {
                font-size: 96px;
            }

            h1 {
                font-size: 30px;
            }

            .description {
                font-size: 13px;
                line-height: 1.65;
            }

            .drone-link {
                min-height: 54px;
                font-size: 13px;
            }

            .footline {
                min-height: 60px;
                font-size: 8px;
            }
        }
    </style>
</head>

<body>
<main class="error-page">

    <div class="accent-shape" aria-hidden="true"></div>

    <div class="container topbar">
        <a href="/" class="logo" aria-label="IndoWings home">
            <img src="https://www.indowings.com/images/logo-mobile.svg" alt="IndoWings">
        </a>

        <div class="error-label">404 / Page Not Found</div>
    </div>

    <div class="main-content">
        <div class="container hero">

            <section class="error-copy">
                <div class="title-mark"></div>

                <div class="code">404</div>

                <h1>Page Not Found</h1>

                <p class="description">
                    The page you are looking for is unavailable or may have moved.
                </p>

                <a href="/" class="home-link">Back to Home</a>
            </section>

            <nav class="drone-nav" aria-label="Explore IndoWings drones">
                <div class="drone-nav-label">Explore Our Drones</div>

                <div class="drone-list">
                    <a class="drone-link" href="/products/cyberone-lite.php">
                        CyberOne Lite
                    </a>

                    <a class="drone-link" href="/products/cyberonepro.php">
                        CyberOne Pro
                    </a>

                    <a class="drone-link" href="/products/cyberonemax.php">
                        CyberOne Max
                    </a>

                    <a class="drone-link" href="/products/cyberone-trainer-drone.php">
                        CyberOne Trainer
                    </a>

                    <a class="drone-link" href="/products/s-seriespro.php">
                        S-Series Pro
                    </a>

                    <a class="drone-link" href="/products/e-seriespro.php">
                        E-Series Pro
                    </a>
                </div>
            </nav>

        </div>
    </div>

    <div class="container footline">
        IndoWings Private Limited
    </div>

</main>
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495" integrity="sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==" data-cf-beacon='{"version":"2024.11.0","token":"59d5564144094ee7a1044bd2205d1e05","r":1,"spa":2}' crossorigin="anonymous"></script>
</body>
</html>