APP_NAME=IndoWings Fleet Management API
APP_ENV=development
HOST=0.0.0.0
PORT=4000

MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=indowings_fleet

# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-starting
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60